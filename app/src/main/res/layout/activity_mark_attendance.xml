<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:text="← Back"
            android:textColor="#2563EB"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Mark Attendance"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Session Details Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#2563EB"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSessionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Class: TY BCA | Subject: Core Java" />

            <TextView
                android:id="@+id/tvSessionMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#DBEAFE"
                android:textSize="13sp"
                tools:text="Date: 2026-10-10 | Lecture 1 (Regular)" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Toggle Select All / Deselect All Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectAll"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#059669"
            android:text="✓ Select All"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeselectAll"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#EF4444"
            android:text="✕ Deselect All"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRosterCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Student Roster"
        android:textColor="#334155"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Student Roster List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMarkStudents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1" />

    <!-- Save & Submit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveAttendance"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#16A34A"
        android:text="Save &amp; Submit Attendance"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="10dp" />

</LinearLayout>